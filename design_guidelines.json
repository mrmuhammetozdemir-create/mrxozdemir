{
  "project_name": "PropTech Turkey",
  "design_philosophy": {
    "theme": "light",
    "style": "Modern Super-App (Getir Inspired)",
    "core_principles": [
      "Mobile-First Card Layout",
      "Clean White Backgrounds",
      "Color-Coded Modules",
      "Data Density with Breathing Room",
      "No Cartoon Illustrations - Use Flat Icons or Real Photos"
    ]
  },
  "typography": {
    "font_family": {
      "heading": "Manrope, sans-serif",
      "body": "Inter, sans-serif",
      "mono": "JetBrains Mono, monospace"
    },
    "scale": {
      "h1": "text-4xl md:text-5xl font-bold tracking-tight",
      "h2": "text-3xl font-semibold tracking-tight",
      "h3": "text-2xl font-semibold",
      "h4": "text-xl font-medium",
      "body_lg": "text-lg leading-relaxed",
      "body_base": "text-base leading-relaxed text-slate-600",
      "body_sm": "text-sm text-slate-500",
      "caption": "text-xs text-slate-400 uppercase tracking-wider"
    }
  },
  "colors": {
    "palette": {
      "brand": {
        "primary": "#4F46E5",
        "secondary": "#10B981",
        "accent": "#F59E0B"
      },
      "modules": {
        "toki": "#3B82F6",
        "land": "#10B981",
        "investment": "#8B5CF6",
        "mega_projects": "#EF4444",
        "education": "#F59E0B",
        "community": "#06B6D4",
        "market": "#6366F1",
        "opportunities": "#059669"
      },
      "neutral": {
        "bg_app": "#F3F4F6",
        "bg_card": "#FFFFFF",
        "text_main": "#111827",
        "text_secondary": "#4B5563",
        "border": "#E5E7EB"
      }
    },
    "usage": {
      "background": "bg-slate-50",
      "card": "bg-white shadow-sm hover:shadow-md transition-shadow duration-200 border border-slate-100",
      "primary_button": "bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm",
      "secondary_button": "bg-white border border-slate-200 text-slate-700 hover:bg-slate-50",
      "module_card": "flex flex-col items-center justify-center p-6 rounded-2xl border border-slate-100 shadow-sm hover:shadow-lg transition-all duration-300 cursor-pointer bg-white group"
    }
  },
  "layout_strategies": {
    "dashboard": "grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6 p-4 md:p-8 max-w-7xl mx-auto",
    "detail_page": "max-w-7xl mx-auto p-4 md:p-8 space-y-6",
    "sidebar_layout": "flex min-h-screen bg-slate-50",
    "mobile_nav": "fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200 p-2 flex justify-around items-center z-50 md:hidden"
  },
  "components": {
    "cards": {
      "style": "rounded-2xl border-none shadow-sm",
      "interaction": "hover:-translate-y-1 transition-transform duration-300"
    },
    "buttons": {
      "default": "rounded-lg font-medium px-4 py-2 transition-colors",
      "large": "h-12 text-lg px-8 rounded-xl"
    },
    "inputs": {
      "style": "h-11 rounded-lg border-slate-200 bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all"
    }
  },
  "visual_enhancers": {
    "shadows": "shadow-[0_2px_8px_rgba(0,0,0,0.04)] hover:shadow-[0_8px_24px_rgba(0,0,0,0.08)]",
    "gradients": "bg-gradient-to-br from-white to-slate-50",
    "borders": "border border-slate-100",
    "icons": "Lucide React (Stroke width: 1.5px or 2px)"
  },
