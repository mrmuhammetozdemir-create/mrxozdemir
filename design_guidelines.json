  "libraries": {
    "maps": "Leaflet (react-leaflet) with OpenStreetMap tile layer",
    "icons": "lucide-react",
    "charts": "recharts (via shadcn/ui charts)",
    "ui_primitives": "shadcn/ui"
  },
  "instructions_to_main_agent": [
    "Strictly follow the 'Getir-style' card layout: Rounded corners, white background, colorful icon containers.",
    "Use the specific HEX codes provided for each module to create visual distinction.",
    "Ensure the map component is responsive and works without an API key (using OSM).",
    "Do NOT use any cartoon illustrations. If an image is needed and not in the list, use a solid color block with an icon.",
    "Implement the 'Mega Projects' map with custom markers using the provided bridge images.",
    "For the 'Investment Analysis' ROI calculator, use a clean two-column layout: Inputs on left, Real-time results card on right.",
    "Adhere to the 'Manrope' for headings and 'Inter' for body font rule.",
    "Use 'sonner' for all notifications.",
    "Ensure all interactive elements have 'data-testid' attributes."
  ],
  "UNIVERSAL_GUIDELINES_FOR_MAIN_AGENT": [
    "Dark colors look good when used independently without gradients. DO NOT use dark colors as gradients",
    "Don't make generic centered layouts, simplistic gradients, and uniform styling.",
    "Create depth through layered design elements with z-index hierarchy",
    "Use glass-morphism effects with backdrop filters (12-24px blur) only for floating overlays (e.g., mobile nav, sticky header).",
    "You MUST NOT apply universal transition. Eg: 'transition: all'. This results in breaking transforms.",
    "You MUST NOT center align the app container, ie do not add '.App { text-align: center; }' in the css file.",
    "Always use modern button styles like pill-shaped, or sharp button with interaction animations & color relevant to the app style",
    "NEVER: use AI assistant Emoji characters for icons.",
    "Every interaction needs micro-animations - hover states, transitions.",
    "Prioritize using pre-existing components from src/components/ui when applicable",
    "Components MUST use named exports",
    "Pages MUST use default exports"
  ]
}